generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AiDecisionLog {
  id           String   @id @default(cuid())
  pair         String
  action       String // "buy" | "sell" | "hold"
  confidence   Float
  reasoning    String
  model        String   @default("")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  // 判断時点のテクニカル指標スナップショット(履歴データや算出不能時はnull)
  rsi14           Float?
  smaDeviationPct Float?
  volatilityPct   Float?

  trades Trade[]
}

model Position {
  id          String    @id @default(cuid())
  pair        String
  side        String // "buy" | "sell"
  entryPrice  Float
  amount      Float
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  closePrice  Float?
  pnl         Float?

  // このポジションを建てたBot戦略(AI判断の場合はnull)
  strategyId String?

  // 出口条件のスナップショット(建玉時点の戦略設定。nullはグローバル設定にフォールバック)
  stopLossPct     Float?
  takeProfitPct   Float?
  trailingStopPct Float?
  // トレーリングストップ用の建玉後最高値
  highestPrice Float?
  // 建玉時に支払った手数料(円)。決済時のpnl計算で控除する
  entryFee Float @default(0)

  trades Trade[]
}

model Trade {
  id            String   @id @default(cuid())
  pair          String
  side          String // "buy" | "sell"
  price         Float
  amount        Float
  reason        String   @default("ai_decision") // "ai_decision" | "stop_loss" | "bot_strategy" | "take_profit" | "trailing_stop"
  executedAt    DateTime @default(now())

  // 発注元のBot戦略(AI判断・自動損切り等の場合はnull)
  strategyId String?

  // この約定で支払った手数料(円換算、taker想定のシミュレーション値)
  fee Float @default(0)

  aiDecisionId String?
  aiDecision   AiDecisionLog? @relation(fields: [aiDecisionId], references: [id])

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])
}

model Strategy {
  id          String   @id @default(cuid())
  name        String
  pair        String   @default("btc_jpy") // 対象ペア(例: "btc_jpy" | "eth_jpy")
  timeframe   String   @default("1min") // 戦略グラフを評価する時間足(CandleTimeframe)
  description String   @default("")
  graph       String // StrategyGraph(ノード/エッジ)のJSON文字列
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 戦略ごとのリスク設定(nullはグローバル設定 config.risk にフォールバック)
  positionSizeJpy  Float?
  maxOpenPositions Int?
  stopLossPct      Float?
  takeProfitPct    Float?
  trailingStopPct  Float?
}

// アプリ設定のキーバリューストア(例: aiDecisionEnabled = "true")
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// AI戦略生成(/api/strategies/generate)のトークン使用ログ
model AiGenerationLog {
  id           String   @id @default(cuid())
  prompt       String
  name         String   @default("")
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())
}

// ダッシュボードのカスタムシグナルモニターの監視条件
model SignalWatch {
  id        String   @id @default(cuid())
  name      String   @default("")
  pair      String
  config    String // SignalWatchConfig(left/op/right)のJSON文字列
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bot戦略シグナルの発火履歴(WS配信とは別に永続化し、リロード後も参照できるようにする)
model BotSignalLog {
  id           String   @id
  strategyId   String
  strategyName String
  pair         String
  action       String // "buy" | "sell"
  price        Float
  triggeredAt  DateTime
  executed     Boolean
  note         String

  // botEngine.tsが発火直前のクールダウン最終確認(戦略ごとの直近シグナル取得)で使う
  @@index([strategyId, triggeredAt])
}

model VirtualBalance {
  id        String   @id @default(cuid())
  currency  String   @unique // "jpy" | "btc" など
  amount    Float
  updatedAt DateTime @updatedAt
}

// Raw 1-minute candles retained for the 3-month simulation snapshot.
model HistoricalCandle {
  id        String   @id @default(cuid())
  pair      String
  time      Int
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime @default(now())

  @@unique([pair, time])
  @@index([pair, time])
}
